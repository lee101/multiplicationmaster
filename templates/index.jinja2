    <link rel="manifest" href="/manifest.webapp">

    {{ macros.headers() }}

    {{ gameon.cssheaders() }}
    {{ macros.cssheaders() }}
    <link type="text/css" rel="stylesheet" href="/static/css/site.css?v=3"/>

    {{ gameon.jsheaders() }}

    {{ macros.jsvars() }}
    {{ macros.jsheaders() }}
    <script type="text/javascript" src="/static/js/share.js?v=3"></script>

    {{ macros.adsenseHeaders() }}

    <script id="start" type="text/html">
        {{ views.start() }}
    </script>
    <script id="difficulties" type="text/html">
        {{ views.difficulties() }}
    </script>
    <script id="levels" type="text/html">
        {{ views.levels() }}
    </script>
    <script id="level" type="text/html">
        {{ views.level() }}
    </script>
    <script id="options" type="text/html">
        {{ views.options() }}
    </script>
    <script id="donelevel" type="text/html">
        {{ views.donelevel() }}
    </script>
</head>
<body>
{{ gameon.templates() }}
<div class="mm-background">
    {{ views.start() }}
</div>
<footer class="mm-site-footer">
    <nav class="mm-more" aria-label="More free games">
        <h2 class="mm-more__title">More free games</h2>
